# =============================================================================
# logr — environment variables
# Copy to .env and point it at your PocketBase instance.
#   cp .env.example .env
# =============================================================================

# PocketBase base URL. Server-only: the browser never talks to PocketBase
# directly, so this may be an internal hostname with no public DNS.
#   Docker compose:  http://pocketbase:8090
#   Local dev:       http://127.0.0.1:8090  (the default when unset)
POCKETBASE_URL=http://pocketbase:8090

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Anthropic API key — server-only. Powers the in-app AI assistant (chat) and
# sharpens project suggestions. Without it, suggestions fall back to local
# history and the assistant is disabled. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Host port for the app container (default 3000). Change if 3000 is in use.
APP_PORT=3000

# Host port for the bundled PocketBase container (default 8090). The admin UI
# is served at http://localhost:<POCKETBASE_PORT>/_/
POCKETBASE_PORT=8090

# Superuser for the bundled PocketBase container, created on first boot so the
# admin UI is reachable without manual setup. Change both before exposing the
# instance to anything public.
PB_ADMIN_EMAIL=admin@logr.local
PB_ADMIN_PASSWORD=changeme_please_1234
