# PocketBase base URL — server-only (never prefixed with NEXT_PUBLIC).
# Defaults to http://127.0.0.1:8090 when unset.
POCKETBASE_URL=http://127.0.0.1:8090
# Optional, server-only — enables the in-app AI assistant + LLM project suggestions.
ANTHROPIC_API_KEY=
# Optional — public origin of this app, used to build the Google OAuth redirect
# URI (<APP_URL>/auth/callback/google). Falls back to the forwarded host headers,
# then the request origin. Set it when a proxy rewrites Host.
APP_URL=http://localhost:3000
